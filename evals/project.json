{
  "name": "evals",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "evals",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "uv run python tools/evals/run_evals.py",
        "cwd": "."
      },
      "cache": true
    },
    "replay": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run python tools/evals/live_run.py --replay free_tier",
          "uv run python tools/evals/live_run.py --replay free_collapsed",
          "uv run python tools/evals/live_run.py --replay premium_tier"
        ],
        "parallel": false,
        "cwd": "."
      },
      "cache": false
    },
    "promote": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python tools/evals/run_evals.py --promote",
        "cwd": "."
      }
    }
  },
  "tags": ["layer:tooling", "platform:python", "scope:core"]
}
