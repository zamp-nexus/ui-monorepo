/**
 * useDLGet<%= className %>ListQuery Hook
 *
 * Fetches a list of <%= propertyName %>s.
 */

import type { FunctionArgs, FunctionReference } from 'convex/server';
import { useDLGetList, type UseDLGetOptions } from '@open-insights-web/foundation-data-layer';
import type { <%= className %> } from '<%= dataModel %>';
import { <%= propertyName %>Keys } from './<%= fileName %>-keys';

export type <%= className %>ListFilters = Record<string, string | number | boolean | null | undefined>;

/**
 * Options for useDLGet<%= className %>ListQuery
 */
export type UseDLGet<%= className %>ListQueryOptions<TQuery extends FunctionReference<'query'>> = Omit<
  UseDLGetOptions<TQuery, <%= className %>[]>,
  'query' | 'args' | 'table' | 'queryKey'
>;

/**
 * Input for useDLGet<%= className %>ListQuery
 */
export interface UseDLGet<%= className %>ListQueryInput<TQuery extends FunctionReference<'query'>> {
  readonly query: TQuery;
  readonly args?: FunctionArgs<TQuery>;
  readonly filters?: <%= className %>ListFilters;
  readonly options?: UseDLGet<%= className %>ListQueryOptions<TQuery>;
}

/**
 * Fetch a list of <%= propertyName %>s.
 *
 * Note: The current foundation data-layer API uses `useDLGetList`.
 * Pagination should be expressed in query args handled by your Convex query.
 */
export function useDLGet<%= className %>ListQuery<TQuery extends FunctionReference<'query'>>(
  input: UseDLGet<%= className %>ListQueryInput<TQuery>
) {
  const { query, args, filters, options } = input;

  const resolvedArgs = args ?? (filters as FunctionArgs<TQuery> | undefined);

  return useDLGetList<TQuery, <%= className %>[]>({
    query,
    args: resolvedArgs,
    table: '<%= propertyName %>s',
    queryKey: <%= propertyName %>Keys.list(filters),
    ...options,
  });
}
